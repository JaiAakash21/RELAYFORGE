# =============================================================================
# RelayForge — example environment file.
# Copy to `.env` and replace every CHANGE_ME value. `.env` is git-ignored.
# Generate strong values with:
#   openssl rand -base64 48      # JWT secret
#   openssl rand -base64 32      # AES-256 encryption key (must decode to 32 bytes)
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=relayforge
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------- Security ----------
# HS512 JWT signing secret. MUST be >= 64 bytes of entropy, base64 or raw text.
RELAYFORGE_JWT_SECRET=CHANGE_ME_at_least_64_characters_of_random_entropy_for_hs512_signing_keys
RELAYFORGE_JWT_ACCESS_TTL=PT15M
RELAYFORGE_JWT_REFRESH_TTL=P7D
# Base64-encoded 32-byte key used for AES-256-GCM encryption of webhook secrets.
RELAYFORGE_ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key
# Comma-separated list of allowed browser origins for the API.
RELAYFORGE_CORS_ORIGINS=http://localhost:3000

# ---------- Outbound webhook / SSRF policy ----------
# dev  = http allowed, private IPs allowed ONLY for hosts in the allowlist below
# prod = https only, no private/loopback/link-local/metadata destinations at all
RELAYFORGE_EGRESS_PROFILE=dev
# Hostnames exempt from the private-IP block in the `dev` profile. Docker service
# names only — never add a wildcard and never add a public hostname here.
RELAYFORGE_EGRESS_DEV_ALLOWLIST=webhook-simulator,localhost,host.docker.internal

# ---------- Runtime role ----------
# api | worker | all
RELAYFORGE_ROLE=all

# ---------- Webhook simulator ----------
SIMULATOR_BASE_URL=http://webhook-simulator:8081

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
RELAYFORGE_TRACING_SAMPLE_RATE=1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ---------- Frontend ----------
# Server-side base URL the Next.js BFF uses to reach the API (never exposed).
RELAYFORGE_API_INTERNAL_URL=http://api:8080
# Public URL of the frontend itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/JaiAakash21/RELAYFORGE

# ---------- Demo seeding ----------
# Seeds a demo tenant/user when true. Never enable in a real deployment.
RELAYFORGE_DEMO_SEED_ENABLED=false
RELAYFORGE_DEMO_EMAIL=demo@relayforge.dev
RELAYFORGE_DEMO_PASSWORD=CHANGE_ME_demo_password
